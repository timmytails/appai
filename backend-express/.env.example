PORT=5000
NODE_ENV=development

# Database
# MONGODB_URI is the canonical variable. MONGO_URI is also accepted for compatibility.
MONGODB_URI=mongodb://127.0.0.1:27017/timmytails

# Authentication
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=7d
GOOGLE_CLIENT_ID=

# Frontend / deployment
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:5173

# SMS OTP via TextBee. Leave LOG_ONLY=true for local development without SMS delivery.
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
TEXTBEE_LOG_ONLY=true

# SMTP / Nodemailer. If credentials are omitted, development email output is logged.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TimmyTails Pet Grooming" <no-reply@timmytails.com>

# Booking rules
MAX_BOOKING_DAYS=90
BOOKING_LEAD_MINUTES=30
BOOKING_CLOSED_DAYS=0

# Google Cloud / Gemini AI preview pipeline
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_CLOUD_ACCESS_TOKEN=
GEMINI_API_KEY=

GEMINI_SOURCE_VERIFICATION_MODEL=gemini-2.5-flash-lite
GEMINI_SOURCE_VERIFICATION_FALLBACK_MODEL=gemini-2.5-flash
GEMINI_FIDELITY_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_SIZE=1K
GEMINI_IMAGE_ASPECT_RATIO=1:1

AI_IMAGE_TIMEOUT_MS=240000
AI_PHOTO_VERIFICATION_TIMEOUT_MS=30000
AI_SOURCE_VERIFICATION_MODEL_TIMEOUT_MS=12000
AI_PROVIDER_MAX_RETRIES=1
AI_PROVIDER_RETRY_DELAY_MS=4000
AI_PREVIEW_VERSION=2026-09-pet-single-subject-v1
AI_PREVIEW_RETENTION_DAYS=7
AI_FIDELITY_CHECK_ENABLED=true
AI_FIDELITY_MAX_GENERATION_ATTEMPTS=1

# Optional custom LoRA inference service. Leave empty to use the Gemini image path.
CUSTOM_LORA_INFERENCE_URL=
CUSTOM_LORA_MODEL_NAME=timmy-tails-lora-v1.5
CUSTOM_LORA_STRENGTH=0.55
CUSTOM_LORA_STEPS=25
CUSTOM_LORA_GUIDANCE=7.5
